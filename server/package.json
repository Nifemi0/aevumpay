{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AevumPay backend: accounts, generated wallets, gasless username payments, storefront.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "start:aevum": "tsx --env-file=.env.aevum src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "viem": "2.57.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

# Copy to server/.env (never commit it).

# --- Chain ---
# Aevum testnet defaults; override for local anvil (see "Local quickstart").
AEVUMPAY_RPC=https://rpc-test.qday.info
AEVUMPAY_CHAIN_ID=44005
# Printed by `make deploy-aevum` (or the local deploy script).
AEVUMPAY_ADDRESS=
# tUSD8 on Aevum testnet. Local anvil uses the MockUSD8 address printed by the deploy script.
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# --- Keys (server only, never expose) ---
# Relayer: pays gas for users' gasless payments. Needs a little tQDAY.
# Fund it from the faucet: https://faucet.qday.info/en
RELAYER_PRIVATE_KEY=
# Signs session tokens. Any long random string.
JWT_SECRET=

# How often the server presses "collect" on due subscriptions (ms). 0 turns it off; collect is
# permissionless, so merchants can still collect from their dashboard.
COLLECTOR_INTERVAL_MS=30000

# Relayer budgets, per UTC day (defaults shown). They stop throwaway accounts and scripts draining the
# relayer's tQDAY. Top-ups only ever cover the next transaction's cost plus 20%.
# RELAYER_DAILY_TOPUP_BUDGET=0.5     # tQDAY handed out in gas top-ups, total
# RELAYER_TOPUPS_PER_WALLET=10
# RELAYER_DAILY_TX_LIMIT=1000        # relayed transactions, total
# RELAYER_TX_PER_WALLET=100

# Welcome grant (server/src/grant.ts): a few test dollars for each new account, sent from a wallet we
# control. Defaults to the treasury key, so the 0.5% shop fees flow back out to new users. Refill it
# from the faucet. Once per account and per wallet ever, once per IP per day, and a daily total cap.
# GRANT_PRIVATE_KEY=                 # optional; falls back to TREASURY_PRIVATE_KEY
# TREASURY_PRIVATE_KEY=
# GRANT_AMOUNT=5                     # tUSD8 per new account
# GRANT_DAILY_LIMIT=25               # grants per UTC day in total; 0 turns grants off
# The Demo Bakery shop (pnpm --filter server seed:demo) belongs to the grant wallet too.
# DEMO_SHOP_USERNAME=demobakery

# --- Storage / http ---
DB_PATH=./data/db.json
PORT=8787

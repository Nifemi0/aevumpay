# Copy to server/.env (never commit it).

# --- Chain ---
# Aevum testnet defaults; override for local anvil (see "Local quickstart").
AEVUMPAY_RPC=https://rpc-test.qday.info
AEVUMPAY_CHAIN_ID=44005
# Printed by `make deploy-aevum` (or the local deploy script).
AEVUMPAY_ADDRESS=
# tUSD8 on Aevum testnet. Local anvil uses the MockUSD8 address printed by the deploy script.
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# --- Keys (server only, never expose) ---
# Relayer: pays gas for users' gasless payments. Needs a little tQDAY.
# Fund it from the faucet: https://faucet.qday.info/en
RELAYER_PRIVATE_KEY=
# Signs session tokens. Any long random string.
JWT_SECRET=

# How often the server presses "collect" on due subscriptions (ms). 0 turns it off; collect is
# permissionless, so merchants can still collect from their dashboard.
COLLECTOR_INTERVAL_MS=30000

# --- Storage / http ---
DB_PATH=./data/db.json
PORT=8787
